# Generates omt_provenance.cpp — an ABI-tagged build stamp compiled into every native lib.
#
# Why this exists: an APK that ships lib/arm64-v8a and lib/x86_64 proves nothing by itself. The two
# trees can be built from different revisions, or one ABI can be a stale artifact copied in from a
# cache, and the APK still installs and still looks green. The stamp makes that visible from the
# shipped artifact alone: each .so carries the revision, the dirty state and a content hash of the
# exact sources that produced it, so a checker can demand that every ABI in the APK agree with each
# other AND with the checkout it is being run against.
#
# Runs at BUILD time (ninja custom command), not just configure time, so editing a .cpp re-stamps.
#
# Inputs:  OMT_REPO_ROOT, OMT_ABI, OMT_OUT
#
# MIT license header omitted: this file is part of the opencamera-omt fork's build, GPL-3.0 like the
# rest of app/src/main/cpp.

if(NOT DEFINED OMT_REPO_ROOT OR NOT DEFINED OMT_ABI OR NOT DEFINED OMT_OUT)
  message(FATAL_ERROR "GenProvenance.cmake needs -DOMT_REPO_ROOT= -DOMT_ABI= -DOMT_OUT=")
endif()

# The hashed set is deliberately ABI-INDEPENDENT: it is every native input of the build, not the
# subset a given ABI happens to compile. Two ABIs of one tree must therefore agree byte for byte;
# an ABI built from a different tree disagrees in omt-src-sha256 and the checker goes red.
file(GLOB_RECURSE OMT_HASHED
     "${OMT_REPO_ROOT}/libvmx/src/*.cpp"
     "${OMT_REPO_ROOT}/libvmx/src/*.h"
     "${OMT_REPO_ROOT}/libomt/cpp/*.cpp"
     "${OMT_REPO_ROOT}/libomt/cpp/*.h"
     "${OMT_REPO_ROOT}/app/src/main/cpp/*.cpp"
     "${OMT_REPO_ROOT}/app/src/main/cpp/*.h"
     "${OMT_REPO_ROOT}/app/src/main/cpp/CMakeLists.txt"
     "${OMT_REPO_ROOT}/app/src/main/cpp/cmake/*.cmake")
list(SORT OMT_HASHED)

set(OMT_AGG "")
foreach(f ${OMT_HASHED})
  file(SHA256 "${f}" h)
  file(RELATIVE_PATH rel "${OMT_REPO_ROOT}" "${f}")
  string(APPEND OMT_AGG "${rel}\n${h}\n")
endforeach()
string(SHA256 OMT_SRC_SHA256 "${OMT_AGG}")

find_program(OMT_GIT git)
set(OMT_GIT_REV "UNKNOWN")
set(OMT_GIT_DIRTY "unknown")
if(OMT_GIT)
  execute_process(COMMAND "${OMT_GIT}" rev-parse HEAD
                  WORKING_DIRECTORY "${OMT_REPO_ROOT}"
                  OUTPUT_VARIABLE out OUTPUT_STRIP_TRAILING_WHITESPACE
                  ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0 AND out)
    set(OMT_GIT_REV "${out}")
  endif()
  # Only the native inputs count for dirtiness: a dirty README must not mark the build tainted,
  # and a touched vmxcodec.cpp must.
  execute_process(COMMAND "${OMT_GIT}" status --porcelain --
                        libvmx/src libomt/cpp app/src/main/cpp
                  WORKING_DIRECTORY "${OMT_REPO_ROOT}"
                  OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE
                  ERROR_QUIET RESULT_VARIABLE drc)
  if(drc EQUAL 0)
    if(dirty STREQUAL "")
      set(OMT_GIT_DIRTY "0")
    else()
      set(OMT_GIT_DIRTY "1")
    endif()
  endif()
endif()

set(OMT_STAMP "omt-build/1 abi=${OMT_ABI} git=${OMT_GIT_REV} dirty=${OMT_GIT_DIRTY} omt-src-sha256=${OMT_SRC_SHA256}")

# `used` + default visibility: the NDK builds with -fdata-sections and links with --gc-sections, so
# an unreferenced global is exactly the kind of thing that vanishes. Exported symbols are GC roots,
# and this must survive `strip` — the shipped .so files are stripped, and the checker reads the
# stamp out of the APK, not out of the build tree.
# .cpp, not .c: the stamp spells extern "C" (see the attribute below).
file(WRITE "${OMT_OUT}"
"/* GENERATED by app/src/main/cpp/cmake/GenProvenance.cmake — do not edit.\n"
"   See that file for why this exists (proving both ABIs came from one source revision). */\n"
"extern \"C\" __attribute__((used, visibility(\"default\")))\n"
"const char OMT_BUILD_STAMP[] = \"${OMT_STAMP}\";\n")

message(STATUS "OMT provenance stamp: ${OMT_STAMP}")
